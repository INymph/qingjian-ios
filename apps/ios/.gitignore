# Rust 构建产物（workspace 统一在根 /target，这里兜底）
qingjian-ios/target/

# XcodeGen 生成的工程（CI 用 xcodegen generate 重新生成）
QJKeyboard/QJKeyboard.xcodeproj/

# Rust xcframework（由 build-xcframework.sh 生成）
QJKeyboard/Frameworks/

# 词库资源由 fetch-resources.sh 在 CI 下载，体积大，不入库；仅保留说明
QJKeyboard/Resources/*
!QJKeyboard/Resources/README.md

# xcodebuild / 打包产物
QJKeyboard/build/
ipa-out/
build-ipa/
*.ipa
